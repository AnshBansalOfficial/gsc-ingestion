# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS / CloudWatch ---
# Credentials come from the default AWS chain (~/.aws/credentials via `aws configure`),
# so no keys belong in this file. Only region + log group are configured here.
AWS_REGION=ap-south-1
CW_LOG_GROUP=/gsc-poc/demo-app

# --- LLM provider (groq | openai | anthropic) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# Groq's free tier works but caps tool-calling models at 8000 tokens/minute,
# which makes an agent run take minutes of waiting rather than seconds:
#   LLM_PROVIDER=groq
#   LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# To demo on Claude instead:
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-5
#   ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=

# --- GitHub (fine-grained PAT: Contents RW + Pull requests RW) ---
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=owner/repo
GITHUB_BASE_BRANCH=master

# --- SMTP (Gmail app password, 16 chars, no spaces) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=you@gmail.com

# --- Ports ---
APP_PORT=8080
ORCHESTRATOR_PORT=8090

# Optional: gpt-oss reasoning effort (low|medium|high) — low keeps token use down
LLM_REASONING_EFFORT=low
